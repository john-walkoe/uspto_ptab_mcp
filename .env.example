# USPTO API Key (required)
# Get your key at: https://developer.uspto.gov/api-catalog
USPTO_API_KEY=your_uspto_api_key_here

# Mistral API Key (OPTIONAL). Adds the OCR tier used for scanned pages that
# carry no native text layer. Documents with a text layer are extracted without
# it, and a self-hosted Docling backend (DOCLING_SERVE_URL, below) can serve the
# same role instead.
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral OCR model slug; `mistral-ocr-latest` (GA, = OCR 4) or pin e.g. mistral-ocr-2503 / mistral-ocr-4-0
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Proxy Configuration
# Local proxy port (PTAB proxy runs on this port)
PTAB_PROXY_PORT=8083
# PROXY_PORT=8083            # Fallback/alternative to PTAB_PROXY_PORT

# Centralized proxy port (set to "none" for standalone mode)
# When using PFW centralized proxy, set to 8080
CENTRALIZED_PROXY_PORT=none

# Extra client IPs/CIDRs allowed at proxy (for Docker subnets, reverse proxies)
# Evaluated against the direct peer (or X-Forwarded-For if behind a trusted proxy)
# PROXY_ALLOWED_IPS=

# Trusted reverse-proxy hop IPs/CIDRs (nginx, NPM, etc on same host)
# When the TCP peer matches, real client IP is read from X-Forwarded-For
# E.g. 127.0.0.1 for local nginx, or the Docker bridge IP
#
# WARNING — these two settings are NOT complementary. Naming a hop here grants
# BLANKET access to everything arriving through it: the allowlist check is
# short-circuited (`allowed = via_trusted_proxy or (...)`), so PROXY_ALLOWED_IPS
# stops constraining those requests entirely and the audience becomes every
# client the reverse proxy will forward. Machine-facing routes stay
# X-Proxy-Token-gated and rate limiting keys on the real client IP, but the IP
# allowlist is not doing anything for that traffic. Set this ONLY when the hop
# itself decides who may reach the proxy.
#
# The opposite misconfiguration also matters: leaving this unset while running
# behind a reverse proxy collapses every client into one shared rate-limit
# bucket, because the TCP peer is then always the hop.
# PROXY_TRUSTED_IPS=

# Persistent download links
# PTAB_LINK_TTL_DAYS: how long a link stays valid (default 7). A link is an
#   unrevocable capability that delegates this server's ODP key for one
#   document, so its life is the only lever bounding the exposure. Shorten it
#   (1) on multi-tenant OAuth deployments.
# PTAB_LINK_ENCRYPTION_KEY: Fernet key for the link cache, from your secret
#   manager. Without it the key is derived from PTAB_AUTH_JWT_SECRET when no
#   key file exists yet, and otherwise written PLAINTEXT beside the database it
#   encrypts (DPAPI is Windows-only; Linux is the production branch).
#   ROTATION BLAST RADIUS: changing this invalidates every outstanding link.
#   They present as quiet 404s, not as an error.
# PTAB_LINK_TTL_DAYS=7
# PTAB_LINK_ENCRYPTION_KEY=

# OCR call quota
# PTAB_OCR_DAILY_LIMIT: rolling 24h OCR-call allowance per caller (default 500,
#   0 disables). The per-minute limit bounds a burst; without this nothing
#   bounded the cumulative total, and one caller sustaining the minute limit
#   runs 14,400 calls a day.
# PTAB_OCR_DAILY_LIMIT=500

# Auth table retention
# PTAB_AUDIT_RETENTION_DAYS: admin_audit_log holds FULL unmasked identities;
#   rows older than this are swept opportunistically (default 365, 0 disables).
# PTAB_CLIENT_RETENTION_DAYS: dynamic client registrations with no live refresh
#   token are dropped after this many days (default 90, 0 disables).
# PTAB_AUDIT_RETENTION_DAYS=365
# PTAB_CLIENT_RETENTION_DAYS=90

# Shared-limiter wait ceiling: how long a call waits for a cross-process token
# or concurrency slot before failing (default 30s). flock is kernel-released on
# process death, but a process that HANGS while holding a slot would otherwise
# stall every later tool call until the MCP client's own timeout.
# USPTO_SHARED_MAX_WAIT_SECONDS=30

# ROTATION BLAST RADIUS — read before rotating any of the below:
# - INTERNAL_AUTH_SECRET is shared by PFW, PTAB, FPD, Citations and the Bifrost
#   gateway. It may be a comma-separated list, current value first
#   ("new,old"), which both the x-api-key transport gate and the inter-MCP
#   service-token verifier accept — a rotation overlap window, so the fleet
#   no longer needs a synchronized restart (S-06, PT-14). Use
#   scripts/rotate_internal_auth_secret.py; any service left on only the old
#   value still returns 401 until it picks up the new one.
# - PROXY_TOKEN must match on both sides of every cross-process call. A missing
#   value degrades to a per-process random one that can never match (fails
#   closed) and the downloads panel simply stays empty.
# - PTAB_AUTH_JWT_SECRET invalidates every outstanding access and refresh token
#   (users sign in again), and, when the link key is derived from it, every
#   outstanding download link too.
# - The USPTO ODP key is shared by all four MCPs; rotate it everywhere at once.

# Internal authentication secret (shared across PFW/FPD/PTAB/Citations MCPs).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# May be "new,old" for a rotation overlap window — see ROTATION BLAST RADIUS
# above and scripts/rotate_internal_auth_secret.py.
INTERNAL_AUTH_SECRET=your_shared_secret_here

# Enable always-on proxy (start proxy server automatically on MCP startup)
ENABLE_ALWAYS_ON_PROXY=true

# Logging configuration
LOG_LEVEL=INFO
# PTAB_LOG_DIR=              # Rotating file logs directory (default: stderr only)
# LOG_DIR=                   # Alternative to PTAB_LOG_DIR (checked if PTAB_LOG_DIR unset)
# PTAB_LOG_MAX_BYTES=10485760 # File log rotation size (default: 10MB)
# PTAB_LOG_BACKUP_COUNT=5    # Number of rotated log files to keep (default: 5)
STRUCTURED_LOGGING=true

# ============================================================
# FastMCP 4.0 settings
# ============================================================

# MCP transport: stdio (default, Claude Desktop) or http (Docker/remote)
FASTMCP_TRANSPORT=stdio
# HTTP mode bind address and port (Windows tip: 8000 is often blocked by the
# Hyper-V/WSL reserved range - use 8765)
#FASTMCP_HOST=127.0.0.1
#FASTMCP_PORT=8765
# Stateless streamable HTTP (default true): no server-side session table, every
# request self-contained. Needed by clients that don't replay mcp-session-id and
# for load-balanced / multi-replica deploys.
#FASTMCP_STATELESS_HTTP=true
# Extra CORS origins for HTTP mode (comma-separated, e.g. https://claude.ai)
#CORS_EXTRA_ORIGIN=

# Externally reachable base URL for the PTAB download proxy (Docker/reverse
# proxy). Unset = http://localhost:{PTAB_PROXY_PORT}
#PTAB_PROXY_BASE_URL=

# Full base URL of the PFW centralized proxy (takes precedence over
# CENTRALIZED_PROXY_PORT). Docker: http://pfw:8080. Remote: external HTTPS base.
#CENTRALIZED_PROXY_URL=

# Fixed proxy auth token for cross-process registration (auto-generated if unset)
#PROXY_TOKEN=

# Runtime data directory for persistent links and encryption keys
# Default: ~/.uspto_ptab_mcp/data (created mode 0700)
# Docker: mount a volume here so persistent links survive redeploys
#PTAB_DATA_DIR=

# USPTO API request configuration
# These control timeouts and retry behavior for USPTO API calls
# USPTO_TIMEOUT=30.0          # Request timeout in seconds (default: 30)
# USPTO_DOWNLOAD_TIMEOUT=60.0 # PDF download timeout in seconds (default: 60)
# USPTO_MAX_RETRIES=3         # Maximum number of retries for failed requests (default: 3)

# Docling OCR (optional third extraction tier: PyPDF2 -> Mistral -> Docling).
# A self-hosted OCR backend: point DOCLING_SERVE_URL at a running docling-serve
# instance. Docling is for SHORT scanned filings; documents above
# DOCLING_MAX_PAGES fall to the Mistral tier.
#DOCLING_SERVE_URL=http://localhost:5001
#DOCLING_SERVE_URL=https://your-docling-host.example.com
#DOCLING_TIMEOUT=300
#DOCLING_MAX_PAGES=20

# Mistral OCR configuration (optional, for advanced tuning)
# MISTRAL_OCR_TIMEOUT=120.0    # Mistral OCR request timeout in seconds (default: 120)
# MISTRAL_OCR_MAX_PAGES=50     # Maximum pages to attempt OCR on in a single call (default: 50)

# Native-text-layer (PyPDF2) extraction page cap. Named to match MISTRAL_OCR_MAX_PAGES
# and DOCLING_MAX_PAGES so one convention covers every extraction tier; this
# was previously the only tier with no upper bound at all.
# PYPDF_MAX_PAGES=200

# =============================================================================
# Response-size guard (shared/response_bounds.py)
# =============================================================================
# CHARACTER budgets, not token estimates: claude.ai replaces an oversized tool
# result with a CLIENT-SIDE truncation error this server never sees, so the
# model gets no data and no way to recover. The guard slims heavy fields and
# drops records to stay under the ceiling, and always marks what it did
# (`_bounds`) or how to page the rest (`_window`). Same variable names in
# uspto_fpd_mcp / uspto_pfw_mcp / uspto_ptab_mcp.
#
# USPTO_MAX_RESPONSE_CHARS=40000       # ceiling for structured tool responses
# USPTO_MAX_CONTENT_CHARS=120000       # ceiling for document-content responses
# USPTO_RESPONSE_BOUNDS_ENABLED=true   # anything but an explicit false leaves
#                                      # the guard ON (fail-safe: a disabled
#                                      # guard fails as an unrecoverable
#                                      # client-side truncation error)

# Extra CSP domains for MCP App iframes (comma-separated)
#MCP_APP_EXTRA_DOMAINS=

# Environment name (for error reporting and logging context)
# Default: production
# ENVIRONMENT=production

# SQLite database configuration
# USPTO_DB_JOURNAL_MODE=WAL   # Write-Ahead Logging mode (default: WAL)

# =============================================================================
# Shared USPTO rate limiting (off by default)
# =============================================================================
# All 4 USPTO MCPs (citations/pfw/ptab/fpd) can run as containers sharing one
# host/netns under a SINGLE USPTO API key. USPTO's documented limits are
# per-KEY (burst=1, no parallel requests; 4-15 req/sec by call type; weekly
# quotas), so a per-process limiter can't see what the other 3 processes are
# doing. Setting USPTO_SHARED_RATE_LIMIT_DIR points all of them at one
# bind-mounted directory; a cross-process token bucket + a bounded pool of
# concurrency slots, both arbitrated via POSIX file locks (flock — released
# automatically by the kernel on process death, so it's crash-safe), keep
# the combined request rate under the shared key's limits. Leave unset for a
# standalone deployment.
# USPTO_SHARED_RATE_LIMIT_DIR=/var/run/uspto-shared-rate-limit
# USPTO_SHARED_RATE_LIMIT_RPS=4.0       # total tokens/sec across ALL 4 MCPs
# USPTO_SHARED_MAX_CONCURRENT=2         # shared in-flight request slots

# =============================================================================
# OAuth sign-in (dual IdP: Google + Entra ID) — HTTP mode only
# =============================================================================
# "none" (default) keeps today's behavior. "oauth" turns the HTTP surface into
# an OAuth 2.1 authorization server: users sign in with Google/Microsoft and
# must have an active row in the mcp_users table (see
# scripts/manage_mcp_users.py and the ptab_manage_users tool). In the suite
# deployment PTAB points PTAB_AUTH_DB_PATH at the shared paid-tier file
# hosted by PFW (shared bind mount, same host only).
# PTAB_AUTH_MODE=oauth
# PTAB_AUTH_BASE_URL=https://your-public-hostname.example.com
# PTAB_AUTH_JWT_SECRET=  # openssl rand -hex 32 — rotating logs everyone out
# PTAB_AUTH_GOOGLE_CLIENT_ID=
# PTAB_AUTH_GOOGLE_CLIENT_SECRET=
# PTAB_AUTH_MS_CLIENT_ID=
# PTAB_AUTH_MS_CLIENT_SECRET=
# PTAB_AUTH_MS_TENANT=common  # common | organizations | tenant GUID
# PTAB_AUTH_INTERNAL_TOKEN=   # openssl rand -hex 32 — static bearer for headless clients
#                            # (ptab:user ONLY — existing internal-gateway
#                            # tokens keep working for the data tools but no
#                            # longer grant ptab:admin; this is intended)
# PTAB_AUTH_INTERNAL_ADMIN_TOKEN=  # openssl rand -hex 32 — SEPARATE static
#                            # bearer granting ptab:user + ptab:admin. Issue
#                            # this only to whichever internal caller
#                            # actually needs to manage users; most
#                            # deployments should leave it unset.
# PTAB_AUTH_ALLOWED_REDIRECT_HOSTS=   # comma-separated EXTRA hosts allowed to
#                            # dynamically register a redirect_uri. claude.ai,
#                            # claude.com, anthropic.com, chatgpt.com, openai.com,
#                            # localhost and 127.0.0.1 are always allowed
#                            # (subdomains included). Clients already registered
#                            # are unaffected.
# PTAB_AUTH_OPEN_REGISTRATION=false   # true restores fully open Dynamic Client
#                            # Registration. Leave false: an arbitrary redirect_uri
#                            # is the first half of an identity-takeover chain.
# PTAB_AUTH_REGISTER_URL=     # optional "Request access" link
# PTAB_AUTH_ACCESS_TTL=3600
# PTAB_AUTH_REFRESH_TTL=2592000
# PTAB_AUTH_DB_PATH=data/mcp_auth.db

# Registration gate for the ptab_manage_users admin tool. Default off: the
# tool is not registered at all (absent from tools/list) unless this is
# "true". stdio never needs it (seed admins with scripts/manage_mcp_users.py);
# in a non-OAuth HTTP deployment it would be protected only by the shared
# INTERNAL_AUTH_SECRET. **OAuth deployments must set this true** or the admin
# tool disappears. When enabled + PTAB_AUTH_MODE=oauth it is additionally
# gated behind the ptab:admin scope.
# PTAB_ENABLE_USER_MANAGEMENT=false

# Registration gate for the 11 PTAB workflow prompt templates. Default off:
# no prompts are registered at all (absent from prompts/list) unless this is
# "true". Set true to register all 11 prompts as before.
# PTAB_ENABLE_PROMPTS=false
